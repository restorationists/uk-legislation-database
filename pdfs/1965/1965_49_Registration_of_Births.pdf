						$("body").addClass("js");
					</script></div><ul id="top" class="accessibleLinks"><li><a href="#content">Skip to main content</a></li><li><a href="#plainViewNav">Skip to navigation</a></li></ul><div id="layout1"><div id="header"><h2><img alt="Legislation.gov.uk" src="/images/chrome/plainViewHeaderTitle.gif" /></h2><a href="/ukpga/1965/49/contents">Back to full view</a></div><div id="background"></div><div id="layout2"><h1 id="pageTitle" class="pageTitle">Registration of Births, Deaths and Marriages (Scotland) Act 1965</h1><div class="interface" id="plainViewNav"></div><div id="content"><div id="viewLegContents" xml:lang="en"><div class="LegSnippet" id="tocControlsAdded"><div class="LegContents LegClearFix"><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/introduction">Introductory Text</a></span></p></li><li class="LegClearFix LegContentsPart tocDefaultExpanded   "><p class="LegContentsNo"><a href="/ukpga/1965/49/part/I">Part I  General Organisation of Registration Service</a></p><ol><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1965/49/part/I/crossheading/central-organisation"> Central Organisation</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/1">1.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/1"> The Registrar General.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/2">2.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/2"> Registrar General’s staff.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/3">3.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/3"> General Register Office.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/4">4.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/4"> Salaries, receipts and expenses.</a></span></p></li></ol></li><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1965/49/part/I/crossheading/local-organisation"> Local Organisation</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/5">5.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/5">Registration districts and local registration authorities</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/6">6.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/6"> Alteration of registration districts.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/7">7.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/7"> Senior and district registrars and other staff.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/8">8.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/8"> Registration offices.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/9">9.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/9"> Area repositories.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/10">10.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/10"> Delivery up of books <span xml:lang="la">etc.</span> on ceasing to hold office.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/11">11.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/11"> General provision as to fees.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/12">12.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/12"> Fees to be accounted for.</a></span></p></li></ol></li></ol></li><li class="LegClearFix LegContentsPart tocDefaultExpanded   "><p class="LegContentsNo"><a href="/ukpga/1965/49/part/II">Part II  Registration of Births</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/13">13.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/13"> Particulars of births to be registered.</a></span></p></li><li class="LegContentsEntry LegConfersPower"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/14">14.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/14">Duty to give information of particulars of birth.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/14A">14A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/14A">Directions about giving information of particulars of birth</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/15">15.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/15"> Duty to give information concerning finding of infant children.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/16">16.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/16"> Registrar’s power to require information concerning birth to be given.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/16A">16A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/16A">Provision of birth particulars to Registrar General</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/16B">16B.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/16B">Registration of births</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/17">17.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/17"> Registration after expiration of three months from date of birth or finding.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/18">18.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/18">Births of children born out of wedlock.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/18ZA">18ZA.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/18ZA">Registration of father or second female parent by virtue of certain provisions of the Human Fertilisation and Embryology Act 2008</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/18A">18A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/18A"> Decrees of parentage and non-parentage.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/18B">18B.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/18B">Births of children where second female parent by virtue of section 43 of the Human Fertilisation and Embryology Act 2008</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/19">19.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/19"> Free abbreviated certificate of birth.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/20">20.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/20"> Re-registration in certain cases.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/21">21.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/21"> Still-births.</a></span></p></li><li class="LegContentsEntry LegConfersPower"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/21A">21A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/21A">Meaning of birth registration form</a></span></p></li></ol></li><li class="LegClearFix LegContentsPart tocDefaultExpanded   "><p class="LegContentsNo"><a href="/ukpga/1965/49/part/III">Part III Registration of Deaths</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/22">22.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/22">Particulars of deaths to be registered.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/23">23.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/23">Duty to give information of particulars of death.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/23A">23A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/23A">Directions about giving information of particulars of death</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/24">24.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/24">Certificate of cause of death.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/24A">24A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/24A">Duty to refer certain certificates of cause of death for review</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/24B">24B.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/24B">Request for review not to stay registration</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/25">25.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/25">Registrar’s power to require information concerning death to be given.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/25A">25A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/25A">Provision of death particulars to Registrar General</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/25B">25B.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/25B">Registration of deaths</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/26">26.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/26">Registration after expiration of three months from date of death or finding of body.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/27">27.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/27">Free certificate of registration of death.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/27A">27A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/27A">Offence of disposal of body without authorisation</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/28">28.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/28">Intimation of certain deaths by registrar to Procurator-Fiscal and vice-versa.</a></span></p></li><li class="LegContentsEntry LegConfersPower"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/28ZA">28ZA.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/28ZA">Meaning of death registration form</a></span></p></li></ol></li><li class="LegClearFix LegContentsPart tocDefaultExpanded   "><p class="LegContentsNo"><a href="/ukpga/1965/49/part/IIIA">Part IIIA </a></p><ol><li class="LegContentsEntry LegConfersPower"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/28A">28A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/28A">Registration of divorces and declarators of nullity of marriage.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/28B">28B.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/28B"> Intimation of death to Community Charges Registration Officer.</a></span></p></li></ol></li><li class="LegClearFix LegContentsPart tocDefaultExpanded   "><p class="LegContentsNo"><a href="/ukpga/1965/49/part/IV">Part IV </a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/2931.">29—31.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/2931.">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . </a></span></p></li></ol></li><li class="LegClearFix LegContentsPart tocDefaultExpanded   "><p class="LegContentsNo"><a href="/ukpga/1965/49/part/V">Part V  General</a></p><ol><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1965/49/part/V/crossheading/registers"> Registers</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/32">32.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/32"> Provision of registers etc. by Registrar General.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/33">33.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/33"> Duplicate and copy registers.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/34">34.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/34">Examination and transmission of registers</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/35">35.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/35"> Reproduction of registers.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/36">36.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/36"> Replacement of lost registers etc.</a></span></p></li></ol></li><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1965/49/part/V/crossheading/searches-and-extracts-etc"> Searches and Extracts, etc.</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/37">37.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/37">Issuing of extracts of entries in current registers</a></span></p></li><li class="LegContentsEntry LegConfersPower"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/38">38.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/38"> Search of indexes kept by Registrar General.</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/39A">39A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/39A">Notice of registration events to third parties</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/39B">39B.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/39B">Application by third party for notification of death</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/39C">39C.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/39C">Provision of information to district registrars</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/39D">39D.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/39D">Searching of indexes and issuing of extracts by district registrars</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/39E">39E.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/39E">Abbreviated extracts</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/41">41.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/41">Form and authentication of registration information</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1965/49/section/41A">41A.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1965/49/section/41A">Admissibility of registration information as evidence</a></span></p></li></ol></li><li class="LegC