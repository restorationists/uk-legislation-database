						$("body").addClass("js");
					</script></div><ul id="top" class="accessibleLinks"><li><a href="#content">Skip to main content</a></li><li><a href="#plainViewNav">Skip to navigation</a></li></ul><div id="layout1"><div id="header"><h2><img alt="Legislation.gov.uk" src="/images/chrome/plainViewHeaderTitle.gif" /></h2><a href="/ukpga/1963/41/contents">Back to full view</a></div><div id="background"></div><div id="layout2"><h1 id="pageTitle" class="pageTitle">Offices, Shops and Railway Premises Act 1963</h1><div class="interface" id="plainViewNav"></div><div id="content"><div id="viewLegContents" xml:lang="en"><div class="LegSnippet" id="tocControlsAdded"><div class="LegContents LegClearFix"><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/introduction">Introductory Text</a></span></p></li><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1963/41/crossheading/scope-of-act"> Scope of Act</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/1">1.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/1"> Premises to which this Act applies. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/2">2.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/2"> Exception for premises in which only employer’s relatives or outworkers work. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/3">3.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/3"> Exception for premises where only 21 manhours weekly normally worked. </a></span></p></li></ol></li><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1963/41/crossheading/health-safety-and-welfare-of-employees-general-provisions"> Health, Safety and Welfare of Employees (General Provisions)</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/4">4.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/4"> Cleanliness. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/5">5.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/5"> Overcrowding. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/6">6.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/6"> Temperature. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/7">7.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/7"> Ventilation. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/8">8.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/8"> Lighting. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/9">9.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/9"> Sanitary conveniences. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/10">10.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/10"> Washing facilities. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/11">11.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/11"> Supply of drinking water. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/12">12.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/12"> Accommodation for clothing. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/13">13.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/13"> Sitting facilities. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/14">14.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/14"> Seats for sedentary work. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/15">15.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/15"> Eating facilities. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/16">16.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/16"> Floors, passages and stairs. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/17">17.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/17"> Fencing of exposed parts of machinery. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/18">18.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/18"> Avoidance of exposure of young persons to danger in cleaning machinery. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/19">19.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/19"> Training and supervision of persons working at dangerous machines. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/2022.">20—22.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/2022.">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/23">23.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/23"> Prohibition of heavy work. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/24">24.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/24">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/2526.">25, 26.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/2526.">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/27">27.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/27">(1) . . . . . . . . ....</a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/2841.">28—41.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/2841.">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . </a></span></p></li></ol></li><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1963/41/crossheading/special-provisions-with-respect-to-buildings-whereof-parts-are-office-c-premises-and-with-respect-to-certain-contiguous-fuel-storage-premises"> Special Provisions with respect to Buildings whereof Parts are Office, &amp;c., Premises and with respect to certain contiguous Fuel Storage Premises</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/42">42.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/42"> Provisions with respect to buildings in single ownership. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/43">43.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/43"> Provisions with respect to buildings plurally owned. </a></span></p></li><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/44">44.</a></span><span class="LegDS LegContentsTitle"><a href="/ukpga/1963/41/section/44"> Provisions with respect to contiguous fuel storage premises in single ownership. </a></span></p></li></ol></li><li class="LegClearFix LegContentsPblock"><p class="LegContentsTitle"><a href="/ukpga/1963/41/crossheading/exemptions"> Exemptions</a></p><ol><li class="LegContentsEntry"><p class="LegContentsItem LegClearFix"><span class="LegDS LegContentsNo"><a href="/ukpga/1963/41/section/45">45.</a></span><span class="LegDS LegCon